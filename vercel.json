{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net; frame-src 'self' https://www.googletagmanager.com;"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/teachers-training",
      "dest": "/teachers-training.html",
      "headers": {
        "X-Robots-Tag": "index, follow"
      },
      "continue": true
    },
    {
      "src": "/postpartum-fitness",
      "dest": "/postpartum-fitness.html",
      "headers": {
        "X-Robots-Tag": "index, follow"
      },
      "continue": true
    },
    {
      "src": "/postpartum",
      "dest": "/postpartum-fitness.html",
      "headers": {
        "X-Robots-Tag": "index, follow"
      },
      "continue": true
    },
    {
      "src": "/about",
      "dest": "/about.html",
      "headers": {
        "X-Robots-Tag": "index, follow"
      },
      "continue": true
    },
    {
      "src": "/teachers-training.html",
      "headers": {
        "Link": "</teachers-training>; rel=\"canonical\"",
        "X-Robots-Tag": "index, follow"
      }
    },
    {
      "src": "/postpartum-fitness.html",
      "headers": {
        "Link": "</postpartum-fitness>; rel=\"canonical\"",
        "X-Robots-Tag": "index, follow"
      }
    },
    {
      "src": "/about.html",
      "headers": {
        "Link": "</about>; rel=\"canonical\"",
        "X-Robots-Tag": "index, follow"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(api|_next|static|public)/.*",
      "continue": true
    },
    {
      "src": "/(.+\\.[a-z]+)$",
      "continue": true
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/api/404.js",
      "check": false
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "index, follow"
      }
    }
  ]
}
